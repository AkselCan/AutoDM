# Ignore top-level data folders
florida/
georgia/
oklahoma/
texas/

# Never commit CSVs: users bring their own data (see README)
*.csv
*.csv.gz

# Jupyter Notebook checkpoints and outputs
.ipynb_checkpoints/
*.ipynb_checkpoints/

# Temporary files created by editors / OS
Thumbs.db
desktop.ini
~$*

# Ignore OneDrive/Office temp files
~*.tmp

# Ignore Protege application and extracted folders
# Protect common Protege distribution folders and executables from being committed
Protege/
Protege-*/
Protege-**/
# Ignore common Protege launch and JVM files (optional, kept generic)
*.exe
*.bat
*.l4j.ini

# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Local secrets and personal settings
.env
.streamlit/secrets.toml
.claude/settings.local.json
