    <rdfs:comment>A parent class for inspections and maintenance actions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.bridge-management-ontology.org/bmo#Inspection">
    <rdfs:subClassOf rdf:resource="http://www.bridge-management-ontology.org/bmo#MaintenanceActivity"/>
    <rdfs:label>Inspection</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.bridge-management-ontology.org/bmo#Event">
    <rdfs:label>Event</rdfs:label>
    <rdfs:comment>An occurrence that happens at a specific point in time.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.bridge-management-ontology.org/bmo#TrafficProfile">
    <rdfs:label>Traffic Profile</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.bridge-management-ontology.org/bmo#MaintenanceAction">
    <rdfs:subClassOf rdf:resource="http://www.bridge-management-ontology.org/bmo#MaintenanceActivity"/>
    <rdfs:label>Maintenance Action</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.bridge-management-ontology.org/bmo#hasElement">
    <rdfs:label>has Element</rdfs:label>
    <rdfs:domain rdf:resource="http://www.bridge-management-ontology.org/bmo#Bridge"/>
    <rdfs:range rdf:resource="http://www.bridge-management-ontology.org/bmo#BridgeElement"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://www.bridge-management-ontology.org/bmo#isPartOf">
        <rdfs:label>is Part Of</rdfs:label>
        <rdfs:domain rdf:resource="http://www.bridge-management-ontology.org/bmo#BridgeElement"/>
        <rdfs:range rdf:resource="http://www.bridge-management-ontology.org/bmo#Bridge"/>
        <owl:inverseOf rdf:resource="http://www.bridge-management-ontology.org/bmo#hasElement"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.bridge-management-ontology.org/bmo#BridgeElement">
    <rdfs:subClassOf rdf:resource="http://www.bridge-management-ontology.org/bmo#Asset"/>
    <rdfs:label>Bridge Element</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.bridge-management-ontology.org/bmo#Location">
    <rdfs:label>Location</rdfs:label>
    <rdfs:comment>A geographical area. A Bridge is 'locatedIn' a Location.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.bridge-management-ontology.org/bmo#DeteriorationProcess">
    <rdfs:label>Deterioration Process</rdfs:label>
    <rdfs:comment>A process (e.g., Corrosion) that an 'Asset' 'experiences'.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.bridge-management-ontology.org/bmo#DeteriorationPrediction">
    <rdfs:label>Deterioration Prediction</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.bridge-management-ontology.org/bmo#Bridge">
    <rdfs:subClassOf rdf:resource="http://www.bridge-management-ontology.org/bmo#Asset"/>
    <rdfs:label>Bridge</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.bridge-management-ontology.org/bmo#Asset">
    <rdfs:label>Asset</rdfs:label>
    <rdfs:comment>A physical entity of value, such as a bridge or its components.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.bridge-management-ontology.org/bmo#WeatherExposure">
    <rdfs:label>Weather Exposure</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.bridge-management-ontology.org/bmo#ConditionRating">
    <rdfs:label>Condition Rating</rdfs:label>
    <rdfs:comment>A rating assigned to a bridge or component during an inspection.</rdfs:comment>
  </owl:Class>
